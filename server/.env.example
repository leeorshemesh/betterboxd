# Copy to server/.env (gitignored). Never put these in the Expo client.

PORT=8787

# Comma-separated browser origins allowed to call the API.
# Local Expo web defaults; for production set to your public HTTPS origin.
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081

# Demo seed users (maya_reels / j.watches / samreads, password "password").
# Local: leave true or unset (seeds when NODE_ENV is not production).
# Railway / production: set false.
ENABLE_SEED=true

# Optional: absolute SQLite path when using a host volume (default: server/data/betterboxd.sqlite)
# BETTERBOXD_DB_PATH=/data/betterboxd.sqlite

# TMDB (movies + TV) — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Spotify Client Credentials — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
