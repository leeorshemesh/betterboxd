# Copy to .env and fill in. Restart Expo after changes: npx expo start -c

# TMDB (movies + TV) — https://www.themoviedb.org/settings/api
EXPO_PUBLIC_TMDB_API_KEY=

# Spotify Web API — https://developer.spotify.com/dashboard
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
# Required for Client Credentials search in this MVP (ships in the client — use a proxy later)
EXPO_PUBLIC_SPOTIFY_CLIENT_SECRET=

# Open Library (books) — no key required
